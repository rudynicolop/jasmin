/* Arguments `target` and `source` are really pointers!
   We treat them as pointers to arrays of `u32` words in memory.

   To get the latex version, run: [./jasmin2tex -o memory_copy.tex memory_copy.jazz]
*/
export
fn jmemcpy (
   reg u64 target,
   reg u64 source,
   reg u64 size
) {

  reg u64 i = 0;

  while (i < size) {
    reg u32 x = [:u32 source + i * 4];
    [:u32 target + i * 4] = x;
    i += 1;
  }
}
